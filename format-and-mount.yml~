---
- name: Format and mount Gentoo partitions
  hosts: installer
  become: true
  gather_facts: false

  collections:
    - community.general
    - ansible.posix

  vars:
    efi_device: /dev/nvme0n1p1
    swap_device: /dev/nvme0n1p2
    root_device: /dev/nvme0n1p3

    gentoo_root: /mnt/gentoo
    gentoo_efi: /mnt/gentoo/efi

  tasks:
    - name: Display target devices
      ansible.builtin.debug:
        msg:
          - "EFI : {{ efi_device }}"
          - "Swap: {{ swap_device }}"
          - "Root: {{ root_device }}"

    - name: Create VFAT filesystem on EFI system partition
      community.general.filesystem:
        dev: "{{ efi_device }}"
        fstype: vfat
        opts: "-F 32"
        force: false

    - name: Create swap filesystem
      community.general.filesystem:
        dev: "{{ swap_device }}"
        fstype: swap
        force: false

    - name: Create XFS filesystem on root partition
      community.general.filesystem:
        dev: "{{ root_device }}"
        fstype: xfs
        opts: "-c options=/usr/share/xfsprogs/mkfs/lts_6.18.conf"
        force: false

    - name: Create Gentoo root mount point
      ansible.builtin.file:
        path: "{{ gentoo_root }}"
        state: directory
        mode: "0755"

    - name: Create EFI mount point
      ansible.builtin.file:
        path: "{{ gentoo_efi }}"
        state: directory
        mode: "0755"

    - name: Activate swap if it is not already active
      ansible.builtin.command:
        cmd: swapon "{{ swap_device }}"
      register: swapon_result
      changed_when: true
      when: swap_device not in swap_devices.stdout

    - name: Check active swap devices
      ansible.builtin.command:
        cmd: swapon --show=NAME --noheadings
      register: swap_devices
      changed_when: false

    - name: Mount Gentoo root filesystem
      ansible.posix.mount:
        path: "{{ gentoo_root }}"
        src: "{{ root_device }}"
        fstype: xfs
        opts: defaults
        state: ephemeral

    - name: Mount EFI system partition
      ansible.posix.mount:
        path: "{{ gentoo_efi }}"
        src: "{{ efi_device }}"
        fstype: vfat
        opts: umask=0077
        state: ephemeral

    - name: Show mounted filesystems
      ansible.builtin.command:
        cmd: findmnt "{{ gentoo_root }}" "{{ gentoo_efi }}"
      register: mounted_filesystems
      changed_when: false

    - name: Display mounted filesystems
      ansible.builtin.debug:
        var: mounted_filesystems.stdout_lines